{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "entries": {
          "$date": {
            ".validate": "newData.hasChildren(['updatedAt', 'createdAt']) && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('updatedAt').isNumber() && newData.child('createdAt').isNumber()"
          }
        },
        "savedQuotes": {
          "$quoteId": {
            ".validate": "newData.hasChildren(['text']) && newData.child('text').isString()"
          }
        }
      }
    }
  }
}
